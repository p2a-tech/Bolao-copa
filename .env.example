# Conexão com o Postgres do docker-compose.yml
DATABASE_URL="postgresql://bolao:bolao@localhost:5432/bolao?schema=public"
JWT_SECRET="defina-um-segredo-forte-e-aleatorio-em-producao"

# Provedor de dados ao vivo: "demo" (simulado, offline) ou "api-football"
LIVE_PROVIDER="demo"
# Chave da API-Football (https://www.api-football.com) — usada só com LIVE_PROVIDER=api-football
API_FOOTBALL_KEY=""

# Chave da OpenAI — usada por `npm run images:hero` (gpt-image-2, retratos 1024×1536)
# Regenerar imagens: npm run images:hero:force
# Recortar fundo das PNGs existentes: npm run images:hero:cutout
OPENAI_API_KEY=""
