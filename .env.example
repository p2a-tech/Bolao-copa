# =================== BANCO DE DADOS ===================
# DEV (Docker local na porta 5434):
DATABASE_URL="postgresql://bolao:bolao@localhost:5434/bolao?schema=public"
DIRECT_URL="postgresql://bolao:bolao@localhost:5434/bolao?schema=public"

# PROD — Neon (Vercel ou Netlify):
# DATABASE_URL="postgresql://user:pass@host-pooler.neon.tech/bolao?sslmode=require&pgbouncer=true&connect_timeout=10"
# DIRECT_URL="postgresql://user:pass@host.neon.tech/bolao?sslmode=require"

# =================== AUTENTICAÇÃO ===================
# OBRIGATÓRIO em produção. O app NÃO INICIA sem isso.
# Gere com: openssl rand -base64 48
JWT_SECRET="defina-um-segredo-forte-e-aleatorio-em-producao"

# =================== STORAGE DE UPLOADS ===================
# A ordem de prioridade do storage é:
#   1. Vercel Blob   → se BLOB_READ_WRITE_TOKEN existir
#   2. Netlify Blobs → se rodando no Netlify (env NETLIFY auto-setada)
#   3. Filesystem local (public/uploads/) → fallback dev

# Vercel: criar Blob Store no dashboard → token é setado automaticamente
BLOB_READ_WRITE_TOKEN=""

# Netlify: não precisa setar nada — o SDK pega o contexto da function
# automaticamente quando NETLIFY=true (env padrão do build).
# Para usar Netlify Blobs em desenvolvimento local com `netlify dev`:
# NETLIFY_BLOBS_CONTEXT="..."  (gerado pela CLI)

# =================== INTEGRAÇÕES OPCIONAIS ===================

# Provedor de dados ao vivo:
#   "demo"         -> simulação determinística offline (default, útil antes da Copa)
#   "api-football" -> dados reais via api-football.com (precisa API_FOOTBALL_KEY)
LIVE_PROVIDER="demo"

# Chave da API-Football (https://www.api-football.com).
# Scripts disponíveis quando setada:
#   npm run live:check   -> diagnóstico (cota da conta, mapeamentos, próximos jogos)
#   npm run live:map     -> mapeia Match -> fixture id da Copa 2026 + atualiza kickoff/venue
#   npm run live:sync    -> puxa placares dos jogos finalizados e recalcula pontos
# Também usada pelo cron GET /api/cron/sync-results, que roda esse sync
# automaticamente (ver "crons" em vercel.json) e mantém o ranking atualizado.
API_FOOTBALL_KEY=""

# Segredo do Vercel Cron. Configure em produção: o Vercel envia
# "Authorization: Bearer <CRON_SECRET>" ao chamar /api/cron/sync-results,
# e a rota recusa qualquer chamada sem esse header. Gere com:
# openssl rand -base64 32
CRON_SECRET=""

# Chave da OpenAI (apenas pra `npm run images:hero`)
OPENAI_API_KEY=""
