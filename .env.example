# =================== BANCO DE DADOS ===================
# Em DEV (Docker local na porta 5434):
DATABASE_URL="postgresql://bolao:bolao@localhost:5434/bolao?schema=public"
DIRECT_URL="postgresql://bolao:bolao@localhost:5434/bolao?schema=public"

# Em PROD (exemplo com Neon pooled):
# DATABASE_URL="postgresql://user:pass@host-pooler.neon.tech/bolao?sslmode=require&pgbouncer=true&connect_timeout=10"
# DIRECT_URL="postgresql://user:pass@host.neon.tech/bolao?sslmode=require"

# =================== AUTENTICAÇÃO ===================
# OBRIGATÓRIO em produção (o app não inicia sem isso).
# Gere com: openssl rand -base64 48
JWT_SECRET="defina-um-segredo-forte-e-aleatorio-em-producao"

# =================== STORAGE DE UPLOADS ===================
# Em DEV: deixe vazio → arquivos vão para public/uploads/ (filesystem local).
# Em PROD (Vercel): obrigatório. Crie um Blob Store em Vercel → Storage → Blob,
# copie o BLOB_READ_WRITE_TOKEN e cole aqui.
BLOB_READ_WRITE_TOKEN=""

# =================== INTEGRAÇÕES OPCIONAIS ===================
# Provedor de dados ao vivo: "demo" (simulado) ou "api-football"
LIVE_PROVIDER="demo"
API_FOOTBALL_KEY=""

# Chave da OpenAI — usada apenas por `npm run images:hero`
# (geração dos retratos dos craques em public/teams/).
OPENAI_API_KEY=""
