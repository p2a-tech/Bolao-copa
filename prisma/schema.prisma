generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Cliente whitelabel (influenciador/marca). Cada Tenant tem usuários,
/// patrocinadores e branding próprios. Teams/Matches são globais.
model Tenant {
  id              String         @id @default(cuid())
  slug            String         @unique
  name            String
  primaryColor    String         @default("#00875A")
  logoUrl         String?
  faviconUrl      String?
  landingTitle    String?
  landingSubtitle String?
  welcomeMessage  String?
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now())
  users           User[]
  sponsors        Sponsor[]
  matchSponsors   MatchSponsor[]
}

model User {
  id           String       @id @default(cuid())
  fullName     String
  phone        String
  email        String       @unique
  cpf          String       @unique
  birthDate    DateTime
  passwordHash String
  isAdmin      Boolean      @default(false) // admin do tenant
  isSuperAdmin Boolean      @default(false) // dono do SaaS (sem tenant)
  tenantId     String?
  tenant       Tenant?      @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  predictions  Prediction[]
}

model Team {
  id          String  @id @default(cuid())
  name        String
  code        String  @unique
  group       String
  homeMatches Match[] @relation("HomeTeam")
  awayMatches Match[] @relation("AwayTeam")
}

model Match {
  id            String         @id @default(cuid())
  stage         String
  venue         String
  kickoff       DateTime
  homeTeamId    String
  awayTeamId    String
  homeTeam      Team           @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam      Team           @relation("AwayTeam", fields: [awayTeamId], references: [id])
  homeScore     Int?
  awayScore     Int?
  finished      Boolean        @default(false)
  externalId    String?
  predictions   Prediction[]
  matchSponsors MatchSponsor[]
}

model Prediction {
  id        String   @id @default(cuid())
  userId    String
  matchId   String
  homeScore Int
  awayScore Int
  points    Int      @default(0)
  user      User     @relation(fields: [userId], references: [id])
  match     Match    @relation(fields: [matchId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, matchId])
}

model Sponsor {
  id        String         @id @default(cuid())
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  logoUrl   String
  linkUrl   String?
  placement String         @default("match") // "global" (master) | "match"
  matches   MatchSponsor[]
}

/// Atribuição por tenant de um Sponsor a um Match (jogos são globais, mas
/// cada tenant tem seu próprio patrocinador por jogo).
model MatchSponsor {
  id        String  @id @default(cuid())
  matchId   String
  tenantId  String
  sponsorId String
  match     Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sponsor   Sponsor @relation(fields: [sponsorId], references: [id], onDelete: Cascade)

  @@unique([matchId, tenantId])
}
